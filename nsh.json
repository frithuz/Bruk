{
  "name": "Bruk",
  "id": "dev.frithuz.bruk",
  "version": "0.0.0",
  "build": 1,
  "icon": "assets/icon.png",
  "appearance": "system",
  "updater": {
    "github": "frithuz/Bruk"
  },
  "rust": "crates/factory-app",
  "root": "App",
  "window": {
    "defaultSize": {
      "width": 1360,
      "height": 920
    },
    "minSize": {
      "width": 960,
      "height": 640
    },
    "restoreBounds": true
  },
  "macos": {
    "infoPlist": {
      "LSApplicationCategoryType": "public.app-category.developer-tools",
      "LSMinimumSystemVersion": "14.0"
    }
  }
}
